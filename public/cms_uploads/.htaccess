# Nonaktifkan eksekusi skrip & akses file HTML/SVG berbahaya di folder upload
Options -ExecCGI -Indexes
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|jsp|asp|sh|cgi|html|htm|shtml|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
